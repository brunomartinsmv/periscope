<?xml version="1.0" encoding="UTF-8"?>
<!--
  Minimal reconstruction of the PrimeFaces themes-project parent POM for
  version 1.0.8. The original is no longer available from any live repository
  and was not captured by the Wayback Machine. Only the coordinates and
  "pom" packaging are needed so that org.primefaces.themes:bootstrap:1.0.8
  (vendored alongside this file) can be resolved as a dependency. The original
  parent's <build>/<modules> sections only applied when building the themes
  themselves and are irrelevant for consuming the prebuilt bootstrap jar.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.primefaces.themes</groupId>
    <artifactId>themes-project</artifactId>
    <version>1.0.8</version>
    <packaging>pom</packaging>
    <name>primefaces themes</name>
</project>
