# EditorConfig — Periscope
# Java sources use 4 spaces; Maven POMs historically use 3 spaces.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 4

[*.{xml,xsd}]
indent_style = space
indent_size = 3

[pom.xml]
indent_style = space
indent_size = 3

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{json,js,css,html,xhtml}]
indent_style = space
indent_size = 4
